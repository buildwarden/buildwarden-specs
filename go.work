go 1.26.3

use (
	./bootstrap-config
	./collector-inputs
	./collector-outputs
	./conformance
	./executor-initialize
	./relay-claim
	./relay-guest-api
)

// The harness version in progress, which is the version at the head of
// conformance/CHANGELOG.md. A specification's go.mod names the harness version
// it will be released with, which has no tag until the release, so the
// workspace builds every specification against this tree's harness. The line
// must name the version: a pull request that raises the harness's version
// edits it too, and ci checks the two agree. On a program trunk a
// specification's go.mod may name a pre-release of that version instead,
// vX.Y.Z-dev.N or -rc.N, and go.work then has a second line like this one at
// that version, since a workspace module is replaced at a version only.
replace github.com/buildwarden/buildwarden-specs/conformance v0.2.0 => ./conformance
